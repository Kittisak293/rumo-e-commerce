JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=3600s

# ---- Postgres ----
# Matches backend/docker-compose.yml, so `docker compose up -d` inside backend/
# with no overrides just works. Point POSTGRES_DB_HOST/PORT at Neon/Supabase/
# Railway instead for a managed instance — set POSTGRES_DB_SSL=true for those
# (they require TLS; local docker-compose Postgres does not support it).
POSTGRES_USER=rumo
POSTGRES_PASSWORD=rumo123
POSTGRES_DB=rumo
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_SSL=false

# ---- intermediate token (OTP challenge) ----
# MUST be a different value from JWT_SECRET. This is the primary defence that
# stops an otpToken from being replayed against AuthGuard-protected routes.
OTP_JWT_SECRET=replace-with-a-DIFFERENT-long-random-secret

# ---- OTP policy ----
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300            # challenge lifetime; also the otpToken exp
OTP_MAX_ATTEMPTS=5             # wrong guesses per challenge before it is burned
OTP_RESEND_COOLDOWN_SECONDS=60 # min seconds between OTP emails per address
OTP_EMAIL_LOCK_MAX=10          # failed verifies per address per window
OTP_EMAIL_LOCK_WINDOW_SECONDS=900
# Pepper for the HMAC-SHA256 of the code before it goes into Redis.
# Lives only in this process, never in Redis, so a stolen dump is worthless.
OTP_HASH_SECRET=replace-with-another-long-random-secret

# ---- Redis (Upstash / Redis Cloud) ----
# Must be rediss:// (two s). Plain redis:// against Upstash gives ECONNRESET.
REDIS_URL=rediss://default:PASSWORD@your-db.upstash.io:6379

# ---- Mail ----
MAIL_TRANSPORT=log             # log | smtp   ("log" prints the OTP to the console)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true               # true for 465, false for 587 (STARTTLS)
MAIL_USER=your-account@gmail.com
MAIL_PASSWORD=abcdefghijklmnop # 16-char Gmail App Password (spaces are stripped)
MAIL_FROM=RUMO <your-account@gmail.com>

# ---- CORS ----
CORS_ORIGIN=http://localhost:9000

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_replace-with-your-key
# From `stripe listen --forward-to localhost:3000/payments/webhook` (Stripe CLI)
STRIPE_WEBHOOK_SECRET=whsec_replace-with-cli-output
